# База данны
DATABASE_URL=changeme_database_path_here
DB_PASSWORD=changeme_strong_password_here

# Авторизация
# JWT_SECRET: минимум 64 случайных символа
# Генерация: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_64_char_random_hex_string

# Cookie secret — можно совпадать с JWT_SECRET, но рекомендуется отдельный
# Генерация: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
COOKIE_SECRET=replace_with_64_char_random_hex_string

# Логин единственного пользователя панели аналитика
ADMIN_LOGIN=cpmind

# bcrypt-хэш пароля (rounds=10)
# Генерация: node -e "require('bcryptjs').hash('YOUR_PASSWORD', 10).then(console.log)"
ADMIN_PASSWORD_HASH=$2b$10$replace_with_real_bcrypt_hash_here

# Backend
NODE_ENV=environment_name_here
LOG_LEVEL=log_level_here
PORT=port_number_here
HOST=host_here

# Frontend — Server Components
BACKEND_URL=paste_backend_url_here

# Frontend — Client Components
NEXT_PUBLIC_BACKEND_URL=paste_backend_url_here